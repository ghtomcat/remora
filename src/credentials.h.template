// LoRaWAN Credentials Template
//
// Copy this file to credentials.h and fill in your device's unique keys
// The credentials.h file is gitignored and will not be committed
//
// Get these values from your TTN console:
// Applications → your app → End devices → your device

#ifndef CREDENTIALS_H
#define CREDENTIALS_H

#include <Arduino.h>

// OTAA credentials (MSB format from TTN console)
// Device EUI (8 bytes) - unique identifier for this device
uint8_t nodeDeviceEUI[8] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};

// Application EUI (8 bytes) - usually all zeros for TTN v3
uint8_t nodeAppEUI[8] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};

// Application Key (16 bytes) - SECRET! Never commit this!
uint8_t nodeAppKey[16] = {
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
};

#endif // CREDENTIALS_H
